POSTGRES_DB=personal_finance_planner
POSTGRES_USER=planner
POSTGRES_PASSWORD=change-this-local-postgres-password

# Internal Redis password for persistent HTTP sessions (keep private in .env).
REDIS_PASSWORD=change-this-local-redis-password

SONAR_DB_NAME=sonar
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=change-this-local-sonar-password

# Browser-facing app uses HTTPS through Tailscale Serve; set false only for plain HTTP access.
SESSION_COOKIE_SECURE=true

# Password recovery email (set these before enabling password recovery).
MAIL_ENABLED=false
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=planwise@example.com
MAIL_PASSWORD=change-this-smtp-app-password
MAIL_FROM=Planwise <planwise@example.com>
MAIL_STARTTLS=true
PUBLIC_BASE_URL=https://your-private-planwise-url.example
